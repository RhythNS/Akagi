@using Akagi.Web.Icons
@using Akagi.Web.Models.Chat
@using Akagi.Web.Services.Circuits

@inject ICircuitIdAccessor CircuitIdAccessor

<div class="card card-link h-100 shadow-sm">
	<div class="card-body d-flex flex-column">
		<div class="d-flex align-items-center gap-3 mb-3">
			<Avatar Rounded="AvatarRounded.Circle"
					Size="AvatarSize.Large"
					@onclick="HandleCharacterClick"
					Data="@($"/socket/cards/{Character.CardId}/image.png?circuitId={CircuitIdAccessor.CircuitId}")" />

			<div class="min-w-0 flex-fill">
				<div class="d-flex align-items-center justify-content-between gap-2">
					<h3 class="card-title m-0 text-truncate">
						<a href="javascript:void(0)" class="text-reset text-decoration-none" @onclick="HandleCharacterClick">
							@Character.Name
						</a>
					</h3>
					@if (HasRecentActivity)
					{
						<span class="badge bg-success-lt d-inline-flex align-items-center gap-1 flex-shrink-0">
							<span class="status-dot status-dot-animated bg-success"></span>
							Active
						</span>
					}
					else
					{
						<span class="badge bg-secondary-lt d-inline-flex align-items-center gap-1 flex-shrink-0">
							<span class="status-dot bg-secondary"></span>
							Idle
						</span>
					}
				</div>

				<div class="text-secondary small mt-1 text-truncate">
					@LastActivityLabel
				</div>
			</div>
		</div>

		<div class="d-flex flex-wrap gap-1 mb-3">
			<span class="badge bg-primary-lt">Companion</span>
			<span class="badge bg-azure-lt">Streaming</span>
			@if (HasMessageHistory)
			{
				<span class="badge bg-purple-lt">History</span>
			}
		</div>

		<div class="mt-auto pt-2">
			<button type="button"
					class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-2"
					@onclick="HandleCharacterClick">
				<Icon IconType="@Icons.Messages" Size="16" />
				<span>Open Chat</span>
			</button>
		</div>
	</div>
</div>

@code {
	[Parameter]
	public required Character Character { get; set; }

	[Parameter]
	public required EventCallback<Character> OnCharacterSelected { get; set; }

	private bool HasMessageHistory =>
		Character.LastMessageTime.HasValue &&
		Character.LastMessageTime.Value > DateTime.MinValue.AddYears(1);

	private bool HasRecentActivity =>
		HasMessageHistory &&
		(DateTime.UtcNow - Character.LastMessageTime!.Value.ToUniversalTime()).TotalDays <= 7;

	private string LastActivityLabel =>
		HasMessageHistory
			? $"Last message: {Character.LastMessageTime!.Value.ToLocalTime():g}"
			: "No messages yet • Ready to chat";

	private async Task HandleCharacterClick()
	{
		await OnCharacterSelected.InvokeAsync(Character);
	}
}
