@using System.Net
@using System.Text
@using System.Text.RegularExpressions
@using Akagi.Web.Icons
@using Akagi.Web.Models.Chat
@using Akagi.Web.Pages.Chat.Components
@using Akagi.Web.Services.Sockets
@using Akagi.Web.Services.Sockets.Requests
@using Microsoft.AspNetCore.Components.Web
@using TabBlazor.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject ISocketClientContainer SocketClientContainer
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ILogger<ChatCharacterChatPage> Logger

@implements IDisposable

@page "/Chat/{CharacterId}/"

<PageTitle>@DisplayName - Akagi Chat</PageTitle>

@if (_loading)
{
	<div class="d-flex flex-column align-items-center justify-content-center py-5 my-5">
		<div class="spinner-border text-primary mb-3" role="status"></div>
		<div class="text-secondary fw-medium">Loading character workspace...</div>
	</div>
	return;
}

<div class="chat-shell card shadow-sm border">
	<!-- Sticky Top Header -->
	<div class="card-header chat-header py-2 px-3 d-flex align-items-center justify-content-between gap-2">
		<div class="d-flex align-items-center gap-3 min-w-0">
			<a href="/Chat/CharacterList"
			   class="btn btn-icon btn-ghost-secondary"
			   title="Back to Character Directory">
				<Icon IconType="@Icons.ArrowLeft" Size="18" />
			</a>

			<div class="d-flex align-items-center gap-2 min-w-0">
				@if (_character != null && !string.IsNullOrEmpty(_character.CardId))
				{
					<Avatar Rounded="AvatarRounded.Circle"
							Size="AvatarSize.Medium"
							Data="@($"/socket/cards/{_character.CardId}/image.png?circuitId={SocketClientContainer.Client?.CircuitId}")" />
				}
				else
				{
					<Avatar Rounded="AvatarRounded.Circle"
							Size="AvatarSize.Medium">
						<Icon IconType="@Icons.Sparkles" Size="18" />
					</Avatar>
				}

				<div class="min-w-0">
					<div class="d-flex align-items-center gap-2">
						<h3 class="card-title m-0 text-truncate">@DisplayName</h3>
						@if (IsStreamingActive || _isSending)
						{
							<span class="badge bg-primary-lt d-inline-flex align-items-center gap-1">
								<span class="status-dot status-dot-animated bg-primary"></span>
								Generating...
							</span>
						}
						else if (SocketClientContainer.IsConnected)
						{
							<span class="badge bg-success-lt d-inline-flex align-items-center gap-1">
								<span class="status-dot bg-success"></span>
								Online
							</span>
						}
						else
						{
							<span class="badge bg-danger-lt d-inline-flex align-items-center gap-1">
								<span class="status-dot bg-danger"></span>
								Offline
							</span>
						}
					</div>
					<div class="text-secondary small text-truncate">
						@(IsDirectAssistant ? "Direct AI Assistant • Unbound Mode" : $"Companion ID: {_character?.Id ?? CharacterId}")
					</div>
				</div>
			</div>
		</div>

		<div class="d-flex align-items-center gap-1">
			<button type="button"
					class="btn btn-icon btn-ghost-secondary"
					@onclick="RefreshAllMessages"
					title="Refresh conversation">
				<Icon IconType="@Icons.Refresh" Size="18" />
			</button>
			<button type="button"
					class="btn btn-icon btn-ghost-secondary"
					@onclick="ExportConversationMarkdownAsync"
					title="Export conversation as Markdown">
				<Icon IconType="@Icons.FileExport" Size="18" />
			</button>
			<button type="button"
					class="btn btn-icon btn-ghost-danger"
					@onclick="ClearConversationView"
					title="Clear current view">
				<Icon IconType="@Icons.Trash" Size="18" />
			</button>
		</div>
	</div>

	<!-- Conversation Thread Area -->
	<div class="chat-scroll" @ref="_scrollEl">
		<div class="chat-thread">
			@if (_conversations.Length == 0 || _conversations.All(c => c.Messages.Count == 0))
			{
				<div class="empty py-5 my-auto">
					<div class="empty-icon text-primary">
						<Icon IconType="@Icons.Sparkles" Size="36" />
					</div>
					<p class="empty-title">Start a conversation with @DisplayName</p>
					<p class="empty-subtitle text-secondary">
						Send a message below to begin streaming responses in real time.
					</p>
				</div>
			}
			else
			{
				@foreach (Conversation conv in _conversations)
				{
					<div class="conversation-separator">
						<span class="badge bg-surface text-secondary border px-2 py-1">
							Conversation #@conv.Id • @conv.Time.ToLocalTime().ToString("g") @(conv.IsCompleted ? "(completed)" : "")
						</span>
					</div>

					DateTime? lastDate = null;

					@foreach (Message baseMessage in conv.Messages)
					{
						if (baseMessage is not TextMessage textMessage)
						{
							continue;
						}

						DateTime currentDate = textMessage.Time.ToLocalTime().Date;
						if (lastDate.HasValue && currentDate != lastDate.Value)
						{
							<div class="day-separator">
								<span class="badge bg-surface text-secondary border px-2 py-1">
									@currentDate.ToString("dddd, MMM d, yyyy")
								</span>
							</div>
						}
						lastDate = currentDate;

						bool fromUser = textMessage.From == Message.Type.User;
						bool isSystem = textMessage.From == Message.Type.System;
						bool isStreaming = IsMessageStreaming(textMessage);
						string senderName = fromUser ? "You" : (isSystem ? "System" : DisplayName);

						<div class="message-row @(fromUser ? "from-user" : "from-character")">
							@if (!fromUser)
							{
								<div class="message-avatar me-2 d-none d-sm-flex">
									@if (_character != null && !string.IsNullOrEmpty(_character.CardId))
									{
										<Avatar Rounded="AvatarRounded.Circle"
												Size="AvatarSize.Small"
												Data="@($"/socket/cards/{_character.CardId}/image.png?circuitId={SocketClientContainer.Client?.CircuitId}")" />
									}
									else
									{
										<Avatar Rounded="AvatarRounded.Circle"
												Size="AvatarSize.Small">
											<Icon IconType="@Icons.Sparkles" Size="14" />
										</Avatar>
									}
								</div>
							}

							<div class="bubble rounded-3 @(fromUser ? "bg-primary text-white" : "bg-surface border text-body") @(isStreaming ? "is-streaming" : "")">
								<div class="meta">
									<strong>@senderName</strong>
									<span class="time">@textMessage.Time.ToLocalTime().ToString("t")</span>
									@if (isStreaming)
									{
										<span class="badge bg-primary-lt ms-1" style="font-size: 0.6rem;">LIVE</span>
									}
								</div>
								<div class="bubble-text">
									@RenderMarkdown(textMessage.Text)
								</div>
							</div>
						</div>
					}
				}
			}
		</div>
	</div>

	<!-- Floating Pill Composer -->
	<div class="composer-wrapper p-2 p-md-3 border-top bg-surface">
		@if (_selectedFile is not null)
		{
			<div class="mb-2 d-flex align-items-center">
				<span class="badge bg-primary-lt d-inline-flex align-items-center gap-2 py-1 px-2">
					<Icon IconType="@Icons.Paperclip" Size="14" />
					<span class="text-truncate" style="max-width: 240px;">@_selectedFile.Name</span>
					<span class="text-secondary">(@(Math.Max(1, _selectedFile.Size / 1024)) KB)</span>
					<button type="button"
							class="btn-close btn-close-sm ms-1"
							aria-label="Remove file"
							@onclick="ClearSelectedFile"></button>
				</span>
			</div>
		}

		<div class="composer-pill d-flex align-items-end gap-2 px-3 py-2 rounded-4 border">
			<label class="btn btn-icon btn-ghost-secondary rounded-circle mb-0 flex-shrink-0"
				   title="Attach file"
				   style="cursor: pointer;">
				<Icon IconType="@Icons.Paperclip" Size="18" />
				<InputFile OnChange="OnFileSelected" class="d-none" />
			</label>

			<textarea class="form-control border-0 bg-transparent shadow-none composer-input px-1 py-1"
					  placeholder="Message @DisplayName... (Enter to send, Shift+Enter for newline)"
					  rows="1"
					  value="@_newMessage"
					  @oninput="OnComposerInput"
					  @onkeydown="OnMessageKeyDown"></textarea>

			@if (IsStreamingActive)
			{
				<button type="button"
						class="btn btn-danger btn-icon rounded-circle flex-shrink-0"
						@onclick="StopActiveStreams"
						title="Stop streaming display">
					<span class="spinner-grow spinner-grow-sm" role="status" aria-hidden="true"></span>
				</button>
			}
			else
			{
				<button type="button"
						class="btn btn-primary btn-icon rounded-circle flex-shrink-0"
						@onclick="SendMessageAsync"
						disabled="@(_isSending || (string.IsNullOrWhiteSpace(_newMessage) && _selectedFile is null))"
						title="Send message">
					<Icon IconType="@Icons.Send" Size="18" />
				</button>
			}
		</div>

		<div class="d-flex justify-content-between align-items-center mt-1 px-2">
			<span class="text-secondary" style="font-size: 0.72rem;">
				@if (IsStreamingActive)
				{
					<span>Receiving live token stream...</span>
				}
				else if (_isSending)
				{
					<span>Sending message...</span>
				}
				else
				{
					<span>Markdown supported</span>
				}
			</span>
			<span class="text-secondary d-none d-md-inline" style="font-size: 0.72rem;">
				<kbd>Enter</kbd> to send • <kbd>Shift + Enter</kbd> for newline
			</span>
		</div>
	</div>
</div>

<style>
	.chat-shell {
		height: calc(100dvh - 5.5rem);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.chat-header {
		flex-shrink: 0;
		background: var(--tblr-bg-surface);
		z-index: 5;
	}

	.chat-scroll {
		flex: 1;
		min-height: 0;
		overflow-y: auto;
		padding: 1rem 1.25rem;
		background: var(--tblr-body-bg);
		scroll-behavior: smooth;
	}

	.chat-thread {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 960px;
		margin: 0 auto;
		min-height: 100%;
	}

	.conversation-separator,
	.day-separator {
		text-align: center;
		margin: 0.75rem 0;
		position: relative;
	}

	.message-row {
		display: flex;
		align-items: flex-end;
	}

	.message-row.from-user {
		justify-content: flex-end;
	}

	.bubble {
		max-width: min(72ch, 82%);
		padding: 0.65rem 0.95rem;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.93rem;
		line-height: 1.45;
		word-break: break-word;
	}

	.bubble .meta {
		font-size: 0.68rem;
		opacity: 0.78;
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.message-row.from-user .bubble .meta {
		color: rgba(255, 255, 255, 0.85);
		justify-content: flex-end;
	}

	.bubble-text {
		white-space: normal;
	}

	.bubble-text p {
		margin-bottom: 0.45rem;
	}

	.bubble-text p:last-child {
		margin-bottom: 0;
	}

	.bubble-text pre.chat-code-block {
		background: rgba(0, 0, 0, 0.28);
		color: #f8f9fa;
		padding: 0.65rem 0.85rem;
		border-radius: 0.5rem;
		overflow-x: auto;
		margin: 0.45rem 0;
		font-size: 0.84rem;
	}

	.bubble-text code:not(pre code) {
		background: rgba(128, 128, 128, 0.18);
		padding: 0.1rem 0.35rem;
		border-radius: 0.25rem;
		font-size: 0.86em;
	}

	.bubble.is-streaming .bubble-text::after {
		content: "▊";
		display: inline-block;
		margin-left: 2px;
		vertical-align: baseline;
		color: var(--tblr-primary, #206bc4);
		animation: blink-caret 0.8s infinite;
	}

	@@keyframes blink-caret {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}

	.composer-wrapper {
		flex-shrink: 0;
	}

	.composer-pill {
		max-width: 960px;
		margin: 0 auto;
		background: var(--tblr-body-bg);
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.composer-pill:focus-within {
		border-color: var(--tblr-primary) !important;
		box-shadow: 0 0 0 2px rgba(var(--tblr-primary-rgb), 0.15);
	}

	.composer-input {
		resize: none;
		min-height: 36px;
		max-height: 180px;
		overflow-y: auto;
		line-height: 1.4;
	}

	@@media (max-width: 991.98px) {
		.chat-shell {
			height: calc(100dvh - 5rem);
		}
	}

	@@media (max-width: 576px) {
		.bubble {
			max-width: 90%;
		}

		.chat-scroll {
			padding: 0.75rem;
		}
	}
</style>

@code {
	[Parameter]
	public required string CharacterId { get; set; } = string.Empty;

	private bool _loading = true;

	private Character? _character = null;
	private Conversation[] _conversations = [];
	private readonly Dictionary<string, TextMessage> _activeStreams = new();

	private string _newMessage = string.Empty;
	private bool _skipNextInputUpdate = false;
	private bool _isSending = false;
	private SocketClient? _subscribedClient;

	private IBrowserFile? _selectedFile = null;
	private const long MaxUploadBytes = 50 * 1024 * 1024; // 50 MB

	// Auto-scroll support
	private ElementReference _scrollEl;
	private IJSObjectReference? _jsModule;
	private bool _pendingScroll;
	private bool _forceScroll;

	private bool IsDirectAssistant =>
		string.Equals(CharacterId, "0", StringComparison.OrdinalIgnoreCase);

	private string DisplayName =>
		IsDirectAssistant ? "Direct Assistant" : (_character?.Name ?? $"Character {CharacterId}");

	private bool IsStreamingActive => _activeStreams.Count > 0;

	public void Dispose()
	{
		SocketClientContainer.ConnectionStateChanged -= OnConnectionStateChanged;
		UnsubscribeFromClient();
	}

	protected override async Task OnInitializedAsync()
	{
		SocketClientContainer.ConnectionStateChanged += OnConnectionStateChanged;

		SocketClient? client = await SocketClientContainer.EnsureConnectedAsync();
		if (client == null)
		{
			EnsureDefaultConversation();
			_loading = false;
			return;
		}

		SubscribeToClient(client);

		if (string.IsNullOrWhiteSpace(CharacterId))
		{
			throw new ArgumentException("CharacterId cannot be null or empty.", nameof(CharacterId));
		}

		if (!IsDirectAssistant)
		{
			CharacterListRequest request = new CharacterListRequest
			{
				Ids = [CharacterId]
			};
			Character[] characters = await request.Get(client);
			if (characters.Length > 0 && characters[0] != null && characters[0].Id == CharacterId)
			{
				_character = characters[0];
			}
		}

		await RefreshAllMessages();

		_loading = false;
	}

	private void SubscribeToClient(SocketClient client)
	{
		if (ReferenceEquals(_subscribedClient, client))
		{
			return;
		}

		UnsubscribeFromClient();
		client.MessageRecieved += OnClientMessageReceived;
		client.StreamChunkReceived += OnClientStreamChunkReceived;
		_subscribedClient = client;
	}

	private void UnsubscribeFromClient()
	{
		if (_subscribedClient != null)
		{
			_subscribedClient.MessageRecieved -= OnClientMessageReceived;
			_subscribedClient.StreamChunkReceived -= OnClientStreamChunkReceived;
			_subscribedClient = null;
		}
	}

	private void OnConnectionStateChanged()
	{
		_ = InvokeAsync(async () =>
		{
			SocketClient? client = SocketClientContainer.Client;
			if (client != null && SocketClientContainer.IsConnected)
			{
				SubscribeToClient(client);

				if (!IsDirectAssistant && _character == null)
				{
					try
					{
						CharacterListRequest request = new CharacterListRequest
						{
							Ids = [CharacterId]
						};
						Character[] characters = await request.Get(client);
						if (characters.Length > 0 && characters[0] != null && characters[0].Id == CharacterId)
						{
							_character = characters[0];
						}

						await RefreshAllMessages();
					}
					catch
					{
						// Ignore transient load errors on reconnect
					}
				}
			}
			StateHasChanged();
		});
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			try
			{
				_jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Chat/ChatCharacterChatPage.razor.js");
				_pendingScroll = true;
				_forceScroll = true;
			}
			catch
			{
				// Ignore JS import issues
			}
		}

		if (_pendingScroll)
		{
			bool force = _forceScroll;
			_pendingScroll = false;
			_forceScroll = false;

			if (_jsModule != null)
			{
				try
				{
					await _jsModule.InvokeVoidAsync("scrollToBottom", _scrollEl, force);
				}
				catch
				{
					// ignore JS errors
				}
			}
		}
	}

	private Conversation EnsureDefaultConversation()
	{
		Conversation? current = _conversations.MaxBy(x => x.Time);
		if (current != null)
		{
			return current;
		}

		Conversation created = new Conversation
		{
			Id = 0,
			Time = DateTime.UtcNow
		};
		_conversations = [created];
		return created;
	}

	private async Task RefreshAllMessages()
	{
		_activeStreams.Clear();

		SocketClient? client = await SocketClientContainer.EnsureConnectedAsync();
		if (client == null)
		{
			EnsureDefaultConversation();
			StateHasChanged();
			return;
		}

		SubscribeToClient(client);

		if (IsDirectAssistant)
		{
			EnsureDefaultConversation();
		}
		else
		{
			ConversationRequest request = new ConversationRequest
			{
				CharacterId = CharacterId,
			};
			_conversations = await request.Get(client);
			if (_conversations.Length == 0)
			{
				EnsureDefaultConversation();
			}
		}

		_pendingScroll = true;
		_forceScroll = true;
		StateHasChanged();
	}

	private async Task SendMessageAsync()
	{
		if (_isSending || (string.IsNullOrWhiteSpace(_newMessage) && _selectedFile is null))
		{
			return;
		}

		SocketClient? client = await SocketClientContainer.EnsureConnectedAsync();
		if (client == null)
		{
			await ToastService.AddToastAsync(new ToastModel
			{
				Title = "Offline",
				Message = "Socket connection is currently unavailable."
			});
			return;
		}

		SubscribeToClient(client);

		string messageToSend = _newMessage?.Trim() ?? string.Empty;
		IBrowserFile? attachedFile = _selectedFile;

		_isSending = true;
		_newMessage = string.Empty;
		_selectedFile = null;

		// Optimistic user message bubble rendered immediately
		Conversation conv = EnsureDefaultConversation();
		string optimisticText = attachedFile != null && string.IsNullOrEmpty(messageToSend)
			? $"[Attachment: {attachedFile.Name}]"
			: messageToSend;

		TextMessage optimisticMessage = new TextMessage
		{
			From = Message.Type.User,
			Text = optimisticText,
			Time = DateTime.UtcNow,
		};
		conv.Messages.Add(optimisticMessage);
		_pendingScroll = true;
		_forceScroll = true;
		StateHasChanged();

		try
		{
			if (attachedFile is not null)
			{
				FileTemp? file = await GetFileContent(attachedFile);
				if (file == null)
				{
					conv.Messages.Remove(optimisticMessage);
					await ToastService.AddToastAsync(new ToastModel
					{
						Title = "Upload failed",
						Message = "Could not upload the selected file."
					});
					return;
				}

				await SendFile(client, messageToSend, file, conv, optimisticMessage);
			}
			else
			{
				await SendText(client, messageToSend, conv, optimisticMessage);
			}
		}
		finally
		{
			_isSending = false;
			StateHasChanged();
		}
	}

	private class FileTemp
	{
		public required string Name { get; init; }
		public required string Type { get; init; }
		public required byte[] Data { get; init; }
	}

	private async Task<FileTemp?> GetFileContent(IBrowserFile file)
	{
		try
		{
			using StreamContent fileContent = new(file.OpenReadStream(MaxUploadBytes));
			byte[] bytes = await fileContent.ReadAsByteArrayAsync();
			return new FileTemp
			{
				Name = file.Name,
				Type = file.ContentType,
				Data = bytes
			};
		}
		catch
		{
			return null;
		}
	}

	private async Task SendText(SocketClient client, string messageToSend, Conversation conv, TextMessage optimisticMessage)
	{
		try
		{
			SendTextMessageRequest request = new SendTextMessageRequest
			{
				CharacterId = CharacterId,
				Text = messageToSend,
			};

			TextMessageResult result = await request.Get(client);
			if (!string.IsNullOrEmpty(result.Error))
			{
				conv.Messages.Remove(optimisticMessage);
				await ToastService.AddToastAsync(new ToastModel
				{
					Title = "Message Response",
					Message = $"Error from character: {result.Error}"
				});
			}
		}
		catch (Exception)
		{
			await ToastService.AddToastAsync(new ToastModel
			{
				Title = "Message Response",
				Message = "Failed to get a response from the character. Please try again."
			});
		}
	}

	private async Task SendFile(SocketClient client, string messageToSend, FileTemp fileToSend, Conversation conv, TextMessage optimisticMessage)
	{
		try
		{
			SendFileMessageRequest request = new SendFileMessageRequest
			{
				CharacterId = CharacterId,
				Text = messageToSend,
				FileName = fileToSend.Name,
				FileType = fileToSend.Type,
				FileData = fileToSend.Data,
			};

			FileMessageResult result = await request.Get(client);
			if (!string.IsNullOrEmpty(result.Error))
			{
				conv.Messages.Remove(optimisticMessage);
				await ToastService.AddToastAsync(new ToastModel
				{
					Title = "Message Response",
					Message = $"Error from character: {result.Error}"
				});
			}
		}
		catch (Exception)
		{
			await ToastService.AddToastAsync(new ToastModel
			{
				Title = "Message Response",
				Message = "Failed to get a response from the character. Please try again."
			});
		}
	}

	private async Task OnMessageKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "Enter" && !e.ShiftKey)
		{
			_skipNextInputUpdate = true;
			await SendMessageAsync();
		}
	}

	private void OnComposerInput(ChangeEventArgs e)
	{
		if (_skipNextInputUpdate)
		{
			_skipNextInputUpdate = false;
			return;
		}

		_newMessage = e.Value?.ToString() ?? string.Empty;
	}

	private void OnClientMessageReceived(string? characterId, Message message)
	{
		if (!string.IsNullOrEmpty(characterId) &&
			!string.Equals(characterId, CharacterId, StringComparison.OrdinalIgnoreCase))
		{
			return;
		}

		InvokeAsync(() =>
		{
			Conversation conv = EnsureDefaultConversation();
			conv.Messages.Add(message);
			_pendingScroll = true;
			StateHasChanged();
		});
	}

	private void OnClientStreamChunkReceived(
		string streamId,
		string? characterId,
		string delta,
		bool isComplete,
		string? fullText)
	{
		if (!string.IsNullOrEmpty(characterId) &&
			!string.Equals(characterId, CharacterId, StringComparison.OrdinalIgnoreCase))
		{
			return;
		}

		InvokeAsync(() =>
		{
			Conversation currentConv = EnsureDefaultConversation();

			if (!_activeStreams.TryGetValue(streamId, out TextMessage? liveMessage))
			{
				if (isComplete && string.IsNullOrWhiteSpace(fullText) && string.IsNullOrWhiteSpace(delta))
				{
					return;
				}

				liveMessage = new TextMessage
				{
					From = Message.Type.Character,
					Time = DateTime.UtcNow,
					Text = delta
				};

				currentConv.Messages.Add(liveMessage);
				_activeStreams[streamId] = liveMessage;
			}
			else
			{
				liveMessage.Text += delta;
			}

			if (isComplete)
			{
				if (!string.IsNullOrEmpty(fullText))
				{
					liveMessage.Text = fullText;
				}
				_activeStreams.Remove(streamId);
			}

			_pendingScroll = true;
			StateHasChanged();
		});
	}

	private bool IsMessageStreaming(TextMessage message)
	{
		foreach (TextMessage active in _activeStreams.Values)
		{
			if (ReferenceEquals(active, message))
			{
				return true;
			}
		}
		return false;
	}

	private void StopActiveStreams()
	{
		_activeStreams.Clear();
		StateHasChanged();
	}

	private void ClearConversationView()
	{
		_activeStreams.Clear();
		_conversations =
		[
			new Conversation
			{
				Id = 0,
				Time = DateTime.UtcNow
			}
		];
		StateHasChanged();
	}

	private async Task ExportConversationMarkdownAsync()
	{
		StringBuilder sb = new();
		sb.AppendLine($"# Chat Export - {DisplayName}");
		sb.AppendLine($"Exported: {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
		sb.AppendLine();

		foreach (Conversation conv in _conversations)
		{
			sb.AppendLine($"## Conversation #{conv.Id} ({conv.Time.ToLocalTime():g})");
			sb.AppendLine();

			foreach (Message msg in conv.Messages)
			{
				if (msg is TextMessage textMsg)
				{
					string sender = textMsg.From == Message.Type.User ? "You" : DisplayName;
					sb.AppendLine($"**{sender}** ({textMsg.Time.ToLocalTime():t}):");
					sb.AppendLine(textMsg.Text);
					sb.AppendLine();
				}
			}
		}

		if (_jsModule != null)
		{
			string safeName = Regex.Replace(DisplayName, @"[^a-zA-Z0-9_-]", "_");
			await _jsModule.InvokeVoidAsync("downloadTextFile", $"{safeName}-chat.md", sb.ToString());
		}
	}

	private static MarkupString RenderMarkdown(string? rawText)
	{
		if (string.IsNullOrEmpty(rawText))
		{
			return new MarkupString(string.Empty);
		}

		string encoded = WebUtility.HtmlEncode(rawText);

		// Extract fenced code blocks first so inner content is not altered by inline rules
		List<string> codeBlocks = [];
		encoded = Regex.Replace(
			encoded,
			@"```(?:[a-zA-Z0-9_+-]+)?\r?\n?([\s\S]*?)```",
			match =>
			{
				string code = match.Groups[1].Value.TrimEnd('\r', '\n');
				string placeholder = $"@@CODEBLOCK_{codeBlocks.Count}@@";
				codeBlocks.Add($"<pre class=\"chat-code-block\"><code>{code}</code></pre>");
				return placeholder;
			});

		// Inline code
		encoded = Regex.Replace(encoded, @"`([^`\r\n]+)`", "<code>$1</code>");

		// Bold & Italic
		encoded = Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
		encoded = Regex.Replace(encoded, @"(?<!\*)\*([^*\r\n]+)\*(?!\*)", "<em>$1</em>");
		encoded = Regex.Replace(encoded, @"~~(.+?)~~", "<del>$1</del>");

		// Process line-by-line for lists, headings, and paragraphs
		string[] lines = encoded.Replace("\r\n", "\n").Split('\n');
		StringBuilder html = new();
		bool inList = false;

		for (int i = 0; i < lines.Length; i++)
		{
			string line = lines[i];
			string trimmed = line.TrimStart();

			if (trimmed.StartsWith("- ") || trimmed.StartsWith("* "))
			{
				if (!inList)
				{
					html.Append("<ul class=\"mb-1 ps-3\">");
					inList = true;
				}
				html.Append("<li>").Append(trimmed[2..]).Append("</li>");
				continue;
			}

			if (inList)
			{
				html.Append("</ul>");
				inList = false;
			}

			if (trimmed.StartsWith("### "))
			{
				html.Append("<div class=\"fw-bold mt-1\">").Append(trimmed[4..]).Append("</div>");
			}
			else if (trimmed.StartsWith("## "))
			{
				html.Append("<div class=\"fw-bold fs-4 mt-1\">").Append(trimmed[3..]).Append("</div>");
			}
			else if (trimmed.StartsWith("# "))
			{
				html.Append("<div class=\"fw-bold fs-3 mt-1\">").Append(trimmed[2..]).Append("</div>");
			}
			else
			{
				html.Append(line);
				if (i < lines.Length - 1)
				{
					html.Append("<br />");
				}
			}
		}

		if (inList)
		{
			html.Append("</ul>");
		}

		string finalHtml = html.ToString();
		for (int i = 0; i < codeBlocks.Count; i++)
		{
			finalHtml = finalHtml.Replace($"@@CODEBLOCK_{i}@@", codeBlocks[i]);
		}

		return new MarkupString(finalHtml);
	}

	private void OnFileSelected(InputFileChangeEventArgs e)
	{
		_selectedFile = e.File;
		StateHasChanged();
	}

	private void ClearSelectedFile()
	{
		_selectedFile = null;
		StateHasChanged();
	}
