@using Akagi.Bridge.Chat.Models
@using Akagi.Web.Icons

<div class="mt-2 ps-2 border-start border-2 small @(Muted ? "opacity-50" : "")" data-finding="@Finding.Id">
	<div class="d-flex flex-wrap align-items-center gap-1 mb-1">
		@if (Finding.Time is double time)
		{
			<button type="button" class="btn btn-sm btn-ghost-primary py-0 px-1 font-monospace" title="Show in the transcript"
					data-jump="@Finding.Id" @onclick="() => OnJump.InvokeAsync(time)">
				@CallText.Timestamp(time)
			</button>
		}
		@if (Finding.Origin != "review")
		{
			<span class="badge bg-secondary-lt">@Finding.Origin</span>
		}
		@if (CallText.QuoteLabel(Finding.Quote) is { Length: > 0 } quote)
		{
			<span class="badge @CallText.QuoteClass(Finding.Quote)" title="@CallText.QuoteTitle(Finding.Quote)">@quote</span>
		}
		@if (Finding.State == CallFindingState.Pending)
		{
			<span class="badge bg-azure-lt">not yet checked</span>
		}
		@if (Finding.Feedback == CallFindingFeedback.NotAMistake)
		{
			<span class="badge bg-secondary-lt">you said: not a mistake</span>
		}
		@if (CanGiveFeedback && Finding.State == CallFindingState.Kept)
		{
			<span class="ms-auto d-inline-flex gap-1">
				<button type="button"
						class="btn btn-sm py-0 px-2 @(Finding.Feedback == CallFindingFeedback.Useful ? "btn-success" : "btn-outline-secondary")"
						title="This one helps"
						data-feedback="useful"
						disabled="@Busy"
						@onclick="() => Send(CallFindingFeedback.Useful)">
					<Icon IconType="@Icons.Check" Size="14" />
					<span class="ms-1">Useful</span>
				</button>
				@if (Finding.Kind is CallFindingKind.Mistake)
				{
					<button type="button"
							class="btn btn-sm py-0 px-2 @(Finding.Feedback == CallFindingFeedback.NotAMistake ? "btn-secondary" : "btn-outline-secondary")"
							title="@(Finding.Feedback == CallFindingFeedback.NotAMistake ? "Count it again" : "Take it out of your diagnosis")"
							data-feedback="not-a-mistake"
							disabled="@Busy"
							@onclick="() => Send(CallFindingFeedback.NotAMistake)">
						Not a mistake
					</button>
				}
			</span>
		}
	</div>

	@switch (Finding.Kind)
	{
		case CallFindingKind.Phrase:
			<div class="fw-medium" lang="ja">@Finding.Said</div>
			@if (!string.IsNullOrWhiteSpace(Finding.Better))
			{
				<div class="text-secondary">@Finding.Better</div>
			}
			break;

		case CallFindingKind.Strength:
			<div class="fw-medium">@Finding.Pattern</div>
			@if (!string.IsNullOrWhiteSpace(Finding.Said))
			{
				<div lang="ja"><span class="text-secondary">Said:</span> @Finding.Said</div>
			}
			break;

		case CallFindingKind.Correct:
			<div lang="ja"><span class="text-secondary">Said:</span> <span class="text-success">@Finding.Said</span></div>
			@if (!string.IsNullOrWhiteSpace(Finding.IssuePattern))
			{
				<div class="text-secondary">Right on: <span lang="ja">@Finding.IssuePattern</span></div>
			}
			break;

		default:
			@if (ShowPattern)
			{
				<div class="fw-medium" lang="ja">@Finding.Category: @Finding.Pattern</div>
			}
			@if (!string.IsNullOrWhiteSpace(Finding.Said))
			{
				<div lang="ja"><span class="text-secondary">Said:</span> <span class="text-danger">@Finding.Said</span></div>
			}
			@if (!string.IsNullOrWhiteSpace(Finding.Better))
			{
				<div lang="ja"><span class="text-secondary">Better:</span> <span class="text-success">@Finding.Better</span></div>
			}
			@if (!string.IsNullOrWhiteSpace(Finding.Explanation))
			{
				<div class="text-secondary">@Finding.Explanation</div>
			}
			break;
	}

	@if (!string.IsNullOrWhiteSpace(Finding.Note))
	{
		<div class="text-secondary fst-italic">@Finding.Note</div>
	}
</div>

@code {
	public record Feedback(string FindingId, CallFindingFeedback Value);

	[Parameter, EditorRequired]
	public CallFindingView Finding { get; set; } = default!;

	[Parameter]
	public bool CanGiveFeedback { get; set; }

	[Parameter]
	public bool Busy { get; set; }

	/// <summary>
	/// Shows the category and pattern, for findings listed outside their struggle.
	/// </summary>
	[Parameter]
	public bool ShowPattern { get; set; }

	[Parameter]
	public EventCallback<double> OnJump { get; set; }

	[Parameter]
	public EventCallback<Feedback> OnFeedback { get; set; }

	private bool Muted => Finding.Feedback == CallFindingFeedback.NotAMistake;

	/// <summary>
	/// Clicking the active choice again takes it back.
	/// </summary>
	private Task Send(CallFindingFeedback value) =>
		OnFeedback.InvokeAsync(new Feedback(Finding.Id, Finding.Feedback == value ? CallFindingFeedback.None : value));
}
