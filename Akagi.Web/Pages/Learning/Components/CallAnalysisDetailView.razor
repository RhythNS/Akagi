@using Akagi.Bridge.Chat.Models
@using Akagi.Web.Icons

@{
	CallAnalysisSummary call = Detail.Summary;
	string partner = string.IsNullOrWhiteSpace(call.Partner) ? "Partner" : call.Partner;
}

<div class="card mb-3" data-call-detail="@call.Id">
	<div class="card-body">
		<div class="d-flex flex-wrap align-items-start gap-2">
			<div class="me-auto">
				<h3 class="h2 mb-1">@CallText.Name(call)</h3>
				<div class="text-secondary small d-flex flex-wrap align-items-center gap-3">
					@if (_editingDate)
					{
						<span class="d-inline-flex align-items-center gap-1" data-date-editor>
							<input type="date" class="form-control form-control-sm w-auto" @bind="_date" aria-label="Day of the call" />
							<button type="button" class="btn btn-sm btn-primary py-0" data-date-save disabled="@Busy" @onclick="SaveDateAsync">Save</button>
							<button type="button" class="btn btn-sm btn-ghost-secondary py-0" @onclick="() => _editingDate = false">Cancel</button>
						</span>
					}
					else
					{
						<span>
							@(call.DateKnown ? call.Date.ToString("D") : $"Uploaded {call.Date.ToLocalTime():D}, call date unknown")
							@if (call.State is CallAnalysisState.Completed or CallAnalysisState.Failed)
							{
								<button type="button" class="btn btn-sm btn-ghost-secondary py-0 px-1 ms-1" title="Correct the day of the call" data-date-edit @onclick="EditDate">
									<Icon IconType="@Icons.Edit" Size="14" />
								</button>
							}
						</span>
					}
					@if (call.DurationSeconds > 0)
					{
						<span>@CallText.Duration(call.DurationSeconds)</span>
					}
					<span>Expected: @Detail.Register</span>
					@if (!string.IsNullOrWhiteSpace(call.Partner) && !string.IsNullOrWhiteSpace(call.Title))
					{
						<span class="text-truncate">@call.Title</span>
					}
				</div>
			</div>
			<a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" href="@($"Learn/Context?add=call:{call.Id}")"
			   title="Add this call to the context you can download for another AI" data-export-call>
				<Icon IconType="@Icons.FileExport" Size="14" />
				<span>Export for AI</span>
			</a>
			<span class="badge @CallText.StateClass(call.State)">@CallText.StateLabel(call.State)</span>
		</div>

		@if (call.State == CallAnalysisState.Failed && !string.IsNullOrWhiteSpace(call.Error))
		{
			<div class="alert alert-danger mt-3 mb-0">
				@call.Error
				<div class="small mt-1">Use <code>/calls retry @ShortId(call.Id)</code> to resume it without paying again for finished parts.</div>
			</div>
		}
		else if (call.State is not CallAnalysisState.Completed and not CallAnalysisState.Failed)
		{
			<div class="mt-3">
				<div class="small text-secondary mb-1">@Progress(call)</div>
				<div class="progress progress-sm">
					<div class="progress-bar @(call.ChunkCount == 0 ? "progress-bar-indeterminate" : "")"
						 style="width: @(call.ChunkCount == 0 ? 100 : call.ChunksAnalyzed * 100 / call.ChunkCount)%"></div>
				</div>
			</div>
		}
	</div>

	<div class="card-body border-top">
		<div class="row g-3 text-center">
			<div class="col-6 col-md-3">
				<div class="h2 m-0" data-stat="struggles">@Detail.Struggles.Count(s => s.TimesInCall > 0)</div>
				<div class="text-secondary small">struggle areas</div>
			</div>
			<div class="col-6 col-md-3">
				<div class="h2 m-0" data-stat="issues">@call.IssueCount</div>
				<div class="text-secondary small">issues noted</div>
			</div>
			<div class="col-6 col-md-3">
				<div class="h2 m-0" data-stat="share">@(Detail.Flow?.LearnerShare is double share ? CallText.Percent(share) : "-")</div>
				<div class="text-secondary small">of the speaking was you</div>
			</div>
			<div class="col-6 col-md-3">
				<div class="h2 m-0" data-stat="words">@(Detail.Vocabulary is { Separated: true } words ? words.LearnerDistinct.ToString() : "-")</div>
				<div class="text-secondary small">different words you used</div>
			</div>
		</div>
	</div>
</div>

@if (Detail.Legacy)
{
	<div class="alert alert-info small">
		This call was analyzed before findings were kept with each call. What is shown was copied from your diagnosis,
		which only keeps the latest few examples per struggle, so some findings of this call may be missing.
		<code>/calls reanalyze @ShortId(call.Id)</code> reviews it again from the stored transcript (paid, no new transcription).
	</div>
}

@if (call.State == CallAnalysisState.Completed && (!Detail.CoachingDone || !Detail.FactsDone))
{
	<div class="alert alert-secondary small" data-catchup>
		This call was analyzed before conversation coaching and notes about the people existed.
		<code>/calls catchup @ShortId(call.Id)</code> adds them from the stored transcript (two requests; nothing else is paid again).
	</div>
}

@if (!string.IsNullOrWhiteSpace(Detail.ReviewSummary) || Detail.Priorities.Length > 0)
{
	<div class="card mb-3" data-review>
		<div class="card-header">
			<h3 class="card-title m-0">Tutor's review</h3>
		</div>
		<div class="card-body">
			@if (!string.IsNullOrWhiteSpace(Detail.ReviewSummary))
			{
				<p class="mb-3">@Detail.ReviewSummary</p>
			}
			@if (Detail.Priorities.Length > 0)
			{
				<div class="form-label">Work on next</div>
				<ol class="mb-0 ps-3">
					@foreach (string priority in Detail.Priorities)
					{
						<li class="mb-1" lang="ja">@priority</li>
					}
				</ol>
			}
		</div>
	</div>
}

<div class="card mb-3">
	<div class="card-header flex-wrap gap-2">
		<h3 class="card-title m-0">Struggles in this call</h3>
		@if (Categories.Count > 1)
		{
			<div class="ms-auto d-flex flex-wrap gap-1">
				<button type="button" class="btn btn-sm @(_category == null ? "btn-primary" : "btn-outline-secondary")" @onclick="() => _category = null">
					All
				</button>
				@foreach ((string category, int count) in Categories)
				{
					<button type="button"
							class="btn btn-sm @(_category == category ? "btn-primary" : "btn-outline-secondary")"
							data-category="@category"
							@onclick="() => _category = category">
						@category <span class="ms-1 opacity-75">@count</span>
					</button>
				}
			</div>
		}
	</div>
	@if (Detail.Struggles.Length == 0)
	{
		<div class="card-body text-secondary">
			@(call.State == CallAnalysisState.Completed
				? "No struggles were recorded from this call."
				: "Struggles appear here as the review works through the call.")
		</div>
	}
	else
	{
		<div class="list-group list-group-flush">
			@foreach (CallStruggle struggle in Detail.Struggles.Where(s => _category == null || s.Category == _category))
			{
				<div class="list-group-item" data-struggle="@StruggleKey(struggle)">
					<div class="d-flex flex-wrap align-items-center gap-1 mb-1">
						<span class="badge bg-purple-lt">@struggle.Category</span>
						<span class="badge @CallText.SeverityClass(struggle.Severity)">@CallText.SeverityLabel(struggle.Severity)</span>
						@if (struggle.Status is { Length: > 0 } status && status != "active")
						{
							<span class="badge @CallText.StatusClass(status)">@status</span>
						}
						<span class="ms-auto text-secondary small">
							@struggle.TimesInCall&times; here@(struggle.TimesOverall is int overall ? $", {overall}× overall" : "")
						</span>
					</div>
					<div class="fw-medium" lang="ja">@struggle.Pattern</div>
					@if (!string.IsNullOrWhiteSpace(struggle.Explanation))
					{
						<div class="text-secondary small">@struggle.Explanation</div>
					}
					@foreach (CallFindingView finding in struggle.Findings)
					{
						<CallFindingItem Finding="finding" CanGiveFeedback="Detail.CanGiveFeedback" Busy="Busy" OnJump="Jump" OnFeedback="OnFeedback" />
					}
				</div>
			}
		</div>
	}
</div>

@if (Detail.CoachingDone)
{
	<CallCoachingCard Detail="Detail" PartnerName="@partner" Busy="Busy" OnJump="Jump" OnFeedback="OnFeedback" />
}

@if (Detail.CorrectUses.Length > 0 || Detail.Strengths.Length > 0)
{
	<div class="card mb-3" data-went-well>
		<div class="card-header">
			<h3 class="card-title m-0">What went well</h3>
		</div>
		<div class="card-body pt-2">
			@if (Detail.CorrectUses.Length > 0)
			{
				<div class="form-label mt-2 mb-0">Known weak spots you got right</div>
				@foreach (CallFindingView finding in Detail.CorrectUses)
				{
					<CallFindingItem Finding="finding" CanGiveFeedback="Detail.CanGiveFeedback" Busy="Busy" OnJump="Jump" OnFeedback="OnFeedback" />
				}
			}
			@if (Detail.Strengths.Length > 0)
			{
				<div class="form-label mt-3 mb-0">Strengths</div>
				@foreach (CallFindingView finding in Detail.Strengths)
				{
					<CallFindingItem Finding="finding" CanGiveFeedback="Detail.CanGiveFeedback" Busy="Busy" OnJump="Jump" OnFeedback="OnFeedback" />
				}
			}
		</div>
	</div>
}

@if (Detail.Phrases.Length > 0)
{
	<div class="card mb-3" data-phrases>
		<div class="card-header">
			<h3 class="card-title m-0">Phrases worth adopting</h3>
			<span class="ms-auto text-secondary small">said by @partner</span>
		</div>
		<div class="card-body pt-2">
			@foreach (CallFindingView finding in Detail.Phrases)
			{
				<CallFindingItem Finding="finding" CanGiveFeedback="Detail.CanGiveFeedback" Busy="Busy" OnJump="Jump" OnFeedback="OnFeedback" />
			}
		</div>
	</div>
}

@if (Detail.FactsDone)
{
	<CallFactsCard Detail="Detail" PartnerName="@partner" HasPartnerName="!string.IsNullOrWhiteSpace(call.Partner)" Busy="Busy" OnJump="Jump" OnFeedback="OnFeedback" />
}

@if (Detail.FilteredOut.Length > 0)
{
	<div class="card mb-3" data-filtered>
		<div class="card-header">
			<h3 class="card-title m-0">Filtered out</h3>
			<span class="badge bg-secondary-lt ms-2">@Detail.FilteredOut.Length</span>
			<button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-filtered-toggle @onclick="() => _showFiltered = !_showFiltered">
				@(_showFiltered ? "Hide" : "Show")
			</button>
		</div>
		@if (_showFiltered)
		{
			<div class="card-body pt-2">
				<div class="text-secondary small">
					Findings the review noted but that do not count: their quotes were not in your lines, or the final check judged them not to be mistakes.
				</div>
				@foreach (CallFindingView finding in Detail.FilteredOut)
				{
					<CallFindingItem Finding="finding" ShowPattern="true" OnJump="Jump" />
				}
			</div>
		}
	</div>
}

@if (Detail.Flow is CallFlow flow)
{
	<CallFlowCard Flow="flow" PartnerName="@partner" />
}

@if (Detail.Vocabulary is CallVocabulary vocabulary && vocabulary.Words.Length > 0)
{
	<CallVocabularyCard Vocabulary="vocabulary" PartnerName="@partner" OnWord="ShowWord" />
}

@if (Detail.Speech is CallSpeech speech)
{
	<div class="card mb-3">
		<div class="card-header">
			<h3 class="card-title m-0">Speech measurements</h3>
			<span class="ms-auto text-secondary small">
				@(speech.LearnerOnly ? "Your own speech" : "All speakers, so only rough")
			</span>
		</div>
		<div class="card-body">
			<div class="text-secondary small mb-3">@speech.JapaneseCharacters Japanese characters in @speech.Sentences sentences.</div>

			<div class="row g-4">
				<div class="col-12 col-md-6">
					<div class="form-label">Fillers and hedges</div>
					@if (speech.Fillers.Length == 0)
					{
						<div class="text-secondary small">None found.</div>
					}
					else
					{
						<table class="table table-sm table-vcenter mb-0">
							<tbody>
								@foreach (CallFiller filler in speech.Fillers)
								{
									<tr data-filler="@filler.Form">
										<td lang="ja">
											@filler.Form
											@if (filler.IsHabit)
											{
												<span class="badge bg-orange-lt ms-1">habit</span>
											}
										</td>
										<td class="text-end text-secondary">@filler.Count&times;</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>

				<div class="col-12 col-md-6">
					<div class="form-label">Politeness</div>
					<div class="d-flex justify-content-between small mb-1">
						<span>Polite endings</span>
						<span>@CallText.Percent(speech.PoliteRatio)</span>
					</div>
					<div class="progress progress-sm mb-2">
						<div class="progress-bar" style="width: @((int)Math.Round(speech.PoliteRatio * 100))%"></div>
					</div>
					<div class="small text-secondary">@speech.Keigo keigo form@(speech.Keigo == 1 ? "" : "s"), expected @speech.ExpectedRegister.</div>
					@if (!string.IsNullOrWhiteSpace(speech.RegisterMismatch))
					{
						<div class="alert alert-warning small mt-2 mb-0 py-2">@speech.RegisterMismatch</div>
					}

					@if (speech.RecurringStructures.Length > 0)
					{
						<div class="form-label mt-3">Recurring sentence frames</div>
						<ul class="small mb-0 ps-3" lang="ja">
							@foreach (string structure in speech.RecurringStructures)
							{
								<li>@structure</li>
							}
						</ul>
					}
				</div>
			</div>

			<div class="form-label mt-4">N2 grammar you used</div>
			@if (speech.Grammar.Length == 0)
			{
				<div class="text-secondary small">No N2 grammar patterns in this call.</div>
			}
			else
			{
				<div class="d-flex flex-wrap gap-2">
					@foreach (CallGrammarUse use in speech.Grammar)
					{
						<span class="badge bg-green-lt" lang="ja" title="@Tooltip(use)">@use.Pattern &times;@use.Count</span>
					}
				</div>
			}
		</div>
	</div>
}

@if (Detail.Costs.Length > 0)
{
	<CallCostCard Costs="Detail.Costs" />
}

@if (!string.IsNullOrWhiteSpace(Detail.Report))
{
	<div class="card mb-3">
		<div class="card-header">
			<h3 class="card-title m-0">Report</h3>
			<span class="ms-2 text-secondary small">@(Detail.Delivered ? "Sent to your companion" : "Not delivered yet")</span>
			<button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-report-toggle @onclick="() => _showReport = !_showReport">
				@(_showReport ? "Hide" : "Show")
			</button>
		</div>
		@if (_showReport)
		{
			<div class="card-body small" style="white-space: pre-wrap;" lang="ja">@Detail.Report</div>
		}
	</div>
}

@if (Detail.Transcript.Length > 0)
{
	<CallTranscriptCard @ref="_transcript" Lines="Detail.Transcript" CallId="@call.Id" />
}

@code {
	[Parameter, EditorRequired]
	public CallAnalysisDetail Detail { get; set; } = default!;

	[Parameter]
	public bool Busy { get; set; }

	[Parameter]
	public EventCallback<CallFindingItem.Feedback> OnFeedback { get; set; }

	[Parameter]
	public EventCallback<DateTime> OnDateChange { get; set; }

	/// <summary>
	/// Seconds into the call to open the transcript at once the call is shown.
	/// </summary>
	[Parameter]
	public double? InitialTime { get; set; }

	private string? _jumpedFor;

	protected override void OnAfterRender(bool firstRender)
	{
		if (InitialTime is double time && _transcript != null && _jumpedFor != Detail.Summary.Id)
		{
			_jumpedFor = Detail.Summary.Id;
			_transcript.JumpTo(time);
		}
	}

	private CallTranscriptCard? _transcript;
	private bool _editingDate;
	private DateTime _date;

	private void EditDate()
	{
		// A known date is a calendar day; an upload time is shown in local time
		_date = Detail.Summary.DateKnown ? Detail.Summary.Date.Date : Detail.Summary.Date.ToLocalTime().Date;
		_editingDate = true;
	}

	private async Task SaveDateAsync()
	{
		_editingDate = false;
		await OnDateChange.InvokeAsync(DateTime.SpecifyKind(_date.Date, DateTimeKind.Utc));
	}
	private string? _category;
	private bool _showFiltered;
	private bool _showReport;
	private string? _shownId;

	private List<(string Category, int Count)> Categories =>
		[.. Detail.Struggles.GroupBy(s => s.Category).OrderByDescending(g => g.Count()).Select(g => (g.Key, g.Count()))];

	protected override void OnParametersSet()
	{
		// A different call starts unfiltered and folded; the same call refreshed after feedback keeps its view
		if (_shownId != Detail.Summary.Id)
		{
			_shownId = Detail.Summary.Id;
			_category = null;
			_showFiltered = false;
			_showReport = false;
			_editingDate = false;
		}
	}

	private void Jump(double time) => _transcript?.JumpTo(time);

	private void ShowWord(CallWordView word) => _transcript?.ShowWord(word);

	private static string StruggleKey(CallStruggle struggle) => struggle.IssueId.Length > 0 ? struggle.IssueId : struggle.Pattern;

	private static string ShortId(string id) => id.Length > 6 ? id[^6..] : id;

	private static string Tooltip(CallGrammarUse use) =>
		string.IsNullOrWhiteSpace(use.Example) ? use.Meaning : $"{use.Meaning} - e.g. {use.Example}";

	private static string Progress(CallAnalysisSummary call) => call.State switch
	{
		CallAnalysisState.Queued => "Waiting for its turn.",
		CallAnalysisState.Transcribing => "Transcribing the recording.",
		CallAnalysisState.Analyzing => $"Reviewed {call.ChunksAnalyzed} of {call.ChunkCount} parts.",
		CallAnalysisState.Consolidating => "Merging and checking the findings.",
		CallAnalysisState.Coaching => "Reading the whole conversation for coaching.",
		CallAnalysisState.Remembering => "Noting what you learned about each other.",
		_ => "Writing the report."
	};
}
