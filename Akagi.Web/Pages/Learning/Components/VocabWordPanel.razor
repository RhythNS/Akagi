@using Akagi.Bridge.Chat.Models
@using System.Net
@using System.Text

<div class="card mb-3 border-primary" data-word-detail="@Word.Lemma">
	<div class="card-header">
		<div>
			<h3 class="card-title m-0" lang="ja">
				@Word.Lemma
				@if (!string.IsNullOrEmpty(Word.Reading))
				{
					<span class="text-secondary fw-normal ms-2">@Word.Reading</span>
				}
			</h3>
			<div class="text-secondary small">
				@Word.Class
				@if (!string.IsNullOrWhiteSpace(Word.Band))
				{
					<span class="badge bg-secondary-lt ms-1" title="How common it is in newspaper Japanese (JMdict)">@Word.Band</span>
				}
				@if (!string.IsNullOrWhiteSpace(Word.Meaning))
				{
					<span class="ms-1">@Word.Meaning</span>
				}
			</div>
		</div>
		<button type="button" class="btn-close ms-auto" aria-label="Close" data-word-close @onclick="OnClose"></button>
	</div>
	<div class="card-body">
		<div class="row g-3 mb-3 text-center">
			<div class="col-6 col-md-3">
				<div class="h2 m-0" data-word-you>@Word.Learner</div>
				<div class="text-secondary small">times you said it</div>
			</div>
			<div class="col-6 col-md-3">
				<div class="h2 m-0">@Word.Partner</div>
				<div class="text-secondary small">times your partners did</div>
			</div>
			<div class="col-6 col-md-3">
				<div class="h4 m-0">@(Word.FirstSaid?.ToString("d") ?? "never")</div>
				<div class="text-secondary small">you first said it</div>
			</div>
			<div class="col-6 col-md-3">
				<div class="h4 m-0">@(Word.FirstHeard?.ToString("d") ?? "never")</div>
				<div class="text-secondary small">a partner first said it</div>
			</div>
		</div>

		<div class="row g-4">
			<div class="col-12 col-md-5">
				<div class="form-label">Forms</div>
				<table class="table table-sm mb-0">
					<thead>
						<tr><th>Form</th><th class="text-end">You</th><th class="text-end">Partners</th></tr>
					</thead>
					<tbody>
						@foreach (VocabForm form in Word.Forms)
						{
							<tr data-form="@form.Surface">
								<td lang="ja">@form.Surface</td>
								<td class="text-end">@form.Learner</td>
								<td class="text-end text-secondary">@form.Partner</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="col-12 col-md-7">
				<VocabSeriesChart Series="Word.Timeline" />
			</div>
		</div>

		<div class="form-label mt-4">
			Every line
			<span class="text-secondary fw-normal small">
				@(Word.TotalLines > Word.Lines.Length ? $"(the newest {Word.Lines.Length} of {Word.TotalLines})" : $"({Word.TotalLines})")
			</span>
		</div>
		<div data-word-lines>
			<VocabLineList Lines="Word.Lines" OnMine="OnMine" Mined="Mined" />
		</div>
	</div>
</div>

@code {
	[Parameter, EditorRequired]
	public VocabWordDetail Word { get; set; } = default!;

	[Parameter]
	public EventCallback OnClose { get; set; }

	/// <summary>
	/// Mines one of the word's lines; without it lines have no mine button.
	/// </summary>
	[Parameter]
	public EventCallback<VocabLine> OnMine { get; set; }

	[Parameter]
	public IReadOnlyCollection<MinedSentenceView> Mined { get; set; } = [];
}
