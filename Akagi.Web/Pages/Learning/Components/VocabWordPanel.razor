@using Akagi.Bridge.Chat.Models
@using System.Net
@using System.Text

<div class="card mb-3 border-primary" data-word-detail="@Word.Lemma">
	<div class="card-header">
		<div>
			<h3 class="card-title m-0" lang="ja">
				@Word.Lemma
				@if (!string.IsNullOrEmpty(Word.Reading))
				{
					<span class="text-secondary fw-normal ms-2">@Word.Reading</span>
				}
			</h3>
			<div class="text-secondary small">
				@Word.Class
				@if (!string.IsNullOrWhiteSpace(Word.Band))
				{
					<span class="badge bg-secondary-lt ms-1" title="How common it is in newspaper Japanese (JMdict)">@Word.Band</span>
				}
				@if (!string.IsNullOrWhiteSpace(Word.Meaning))
				{
					<span class="ms-1">@Word.Meaning</span>
				}
			</div>
		</div>
		<button type="button" class="btn-close ms-auto" aria-label="Close" data-word-close @onclick="OnClose"></button>
	</div>
	<div class="card-body">
		<div class="row g-3 mb-3 text-center">
			<div class="col-6 col-md-3">
				<div class="h2 m-0" data-word-you>@Word.Learner</div>
				<div class="text-secondary small">times you said it</div>
			</div>
			<div class="col-6 col-md-3">
				<div class="h2 m-0">@Word.Partner</div>
				<div class="text-secondary small">times your partners did</div>
			</div>
			<div class="col-6 col-md-3">
				<div class="h4 m-0">@(Word.FirstSaid?.ToString("d") ?? "never")</div>
				<div class="text-secondary small">you first said it</div>
			</div>
			<div class="col-6 col-md-3">
				<div class="h4 m-0">@(Word.FirstHeard?.ToString("d") ?? "never")</div>
				<div class="text-secondary small">a partner first said it</div>
			</div>
		</div>

		<div class="row g-4">
			<div class="col-12 col-md-5">
				<div class="form-label">Forms</div>
				<table class="table table-sm mb-0">
					<thead>
						<tr><th>Form</th><th class="text-end">You</th><th class="text-end">Partners</th></tr>
					</thead>
					<tbody>
						@foreach (VocabForm form in Word.Forms)
						{
							<tr data-form="@form.Surface">
								<td lang="ja">@form.Surface</td>
								<td class="text-end">@form.Learner</td>
								<td class="text-end text-secondary">@form.Partner</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="col-12 col-md-7">
				<VocabSeriesChart Series="Word.Timeline" />
			</div>
		</div>

		<div class="form-label mt-4">
			Every line
			<span class="text-secondary fw-normal small">
				@(Word.TotalLines > Word.Lines.Length ? $"(the newest {Word.Lines.Length} of {Word.TotalLines})" : $"({Word.TotalLines})")
			</span>
		</div>
		<div style="max-height: 24rem; overflow-y: auto;" data-word-lines>
			@foreach (VocabLine line in Word.Lines)
			{
				<div class="d-flex gap-3 py-1 border-bottom small @(line.IsLearner ? "line-mine" : "")">
					<a class="text-secondary font-monospace flex-shrink-0 text-nowrap" href="@VocabText.CallUri(line.CallId, line.Time)" title="Open the call at this line">
						@line.Date.ToString("d") @CallText.Timestamp(line.Time)
					</a>
					<span class="text-secondary flex-shrink-0" style="min-width: 3rem;">@line.Speaker</span>
					<span lang="ja">@Marked(line)</span>
				</div>
			}
		</div>
	</div>
</div>

@code {
	[Parameter, EditorRequired]
	public VocabWordDetail Word { get; set; } = default!;

	[Parameter]
	public EventCallback OnClose { get; set; }

	/// <summary>
	/// The line with the word's forms marked.
	/// </summary>
	private static MarkupString Marked(VocabLine line)
	{
		StringBuilder html = new();
		int position = 0;
		string text = line.Text;
		while (position < text.Length)
		{
			(int at, string mark) = line.Marks
				.Select(m => (At: text.IndexOf(m, position, StringComparison.Ordinal), Mark: m))
				.Where(m => m.At >= 0 && m.Mark.Length > 0)
				.OrderBy(m => m.At)
				.ThenByDescending(m => m.Mark.Length)
				.FirstOrDefault((-1, string.Empty));
			if (at < 0)
			{
				break;
			}
			html.Append(WebUtility.HtmlEncode(text[position..at])).Append("<mark>").Append(WebUtility.HtmlEncode(mark)).Append("</mark>");
			position = at + mark.Length;
		}
		html.Append(WebUtility.HtmlEncode(text[position..]));
		return new MarkupString(html.ToString());
	}
}
