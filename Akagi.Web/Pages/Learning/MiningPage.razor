@page "/Learn/Mining"

@using Akagi.Bridge.Chat.Models
@using Akagi.Bridge.Chat.Transmissions.Requests
@using Akagi.Bridge.Chat.Transmissions.Responses
@using Akagi.Web.Icons
@using Akagi.Web.Pages.Learning.Components
@using Akagi.Web.Services.Sockets
@using Akagi.Web.Services.Sockets.Requests

@implements IDisposable
@inject ISocketClientContainer SocketClientContainer

<PageTitle>Mined sentences - Akagi</PageTitle>

<div class="page-header d-print-none mb-4">
	<div class="page-pretitle">Learn</div>
	<h2 class="page-title">Mined sentences</h2>
	<div class="text-secondary small mt-1">
		Everything you mined. Open one for its clip and downloads. To mine more, use <span class="badge bg-secondary-lt">Mine</span> next to a
		line in a call's transcript or on the <a href="Learn/Vocabulary">vocabulary page</a>.
	</div>
</div>

@if (_error != null)
{
	<div class="alert alert-danger" role="alert">@_error</div>
}

@if (_loaded)
{
	<div class="card">
		<div class="card-header">
			<h3 class="card-title m-0">Your sentences</h3>
			<span class="badge bg-secondary-lt ms-2">@_sentences.Length</span>
		</div>
		@if (_sentences.Length == 0)
		{
			<div class="card-body text-secondary" data-mining-empty>Nothing mined yet.</div>
		}
		else
		{
			<div class="table-responsive">
				<table class="table table-sm table-vcenter card-table mb-0" data-mined>
					<thead>
						<tr>
							<th>Sentence</th>
							<th>From</th>
							<th>Clip</th>
							<th class="w-1"></th>
						</tr>
					</thead>
					<tbody>
						@foreach (MinedSentenceView sentence in _sentences)
						{
							<tr data-sentence="@sentence.Id">
								<td lang="ja">
									<a class="text-reset" href="@CallText.MineUri(sentence.Id)" data-open="@sentence.Id">
										@VocabLineList.Marked(new VocabLine { Text = sentence.Text, Marks = sentence.Target.Length > 0 ? [sentence.Target] : [] })
									</a>
								</td>
								<td class="small text-nowrap">
									<a href="@VocabText.CallUri(sentence.CallId, sentence.Start)" title="Open the call at this line">@sentence.CallName</a>
									<div class="text-secondary">@sentence.Date.ToString("d") @CallText.Timestamp(sentence.Start), @sentence.Speaker</div>
								</td>
								<td><span class="badge @StateClass(sentence.State)" data-clip-state>@StateLabel(sentence.State)</span></td>
								<td class="text-nowrap">
									@if (_confirm == sentence.Id)
									{
										<button type="button" class="btn btn-sm btn-danger py-0" disabled="@_busy" data-remove-yes="@sentence.Id"
												@onclick="() => RemoveAsync(sentence.Id)">Remove</button>
										<button type="button" class="btn btn-sm btn-outline-secondary py-0" data-remove-no @onclick="() => _confirm = null">Keep</button>
									}
									else
									{
										<a class="btn btn-sm btn-ghost-primary py-0 px-1" href="@CallText.MineUri(sentence.Id)" title="Clip and downloads">Open</a>
										<button type="button" class="btn btn-sm btn-ghost-danger py-0 px-1" title="Remove the sentence and its clip"
												data-remove="@sentence.Id" @onclick="() => _confirm = sentence.Id">
											<Icon IconType="@Icons.Trash" Size="14" />
										</button>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}
else if (_offline)
{
	<div class="card border-danger">
		<div class="card-body py-5 text-center">
			<h3 class="h4 mb-1">Socket Service Offline</h3>
			<p class="text-secondary mb-3">Unable to reach the Akagi backend. Your mined sentences are stored there.</p>
			<button type="button" class="btn btn-primary" @onclick="LoadAsync">Retry Connection</button>
		</div>
	</div>
}
else
{
	<div class="card"><div class="card-body py-5 text-center"><div class="spinner-border text-primary"></div></div></div>
}

@code {
	private MinedSentenceView[] _sentences = [];
	private bool _loaded;
	private bool _offline;
	private bool _busy;
	private string? _confirm;
	private string? _error;

	protected override void OnInitialized()
	{
		SocketClientContainer.ConnectionStateChanged += OnConnectionStateChanged;
	}

	protected override Task OnInitializedAsync() => LoadAsync();

	private async Task LoadAsync()
	{
		_offline = false;
		MiningResponseTransmission? response = await SendAsync(new MiningRequestTransmission { Action = MiningAction.List });
		if (response == null)
		{
			_offline = true;
			return;
		}
		_sentences = response.Sentences;
		_loaded = true;
	}

	private async Task RemoveAsync(string id)
	{
		_busy = true;
		MiningResponseTransmission? response = await SendAsync(new MiningRequestTransmission { Action = MiningAction.Remove, Id = id });
		_busy = false;
		_confirm = null;
		if (response is { Error: null })
		{
			_sentences = [.. _sentences.Where(s => s.Id != id)];
		}
	}

	internal static string StateLabel(MinedClipState state) => state switch
	{
		MinedClipState.Ready => "ready",
		MinedClipState.Queued or MinedClipState.Cutting => "cutting",
		MinedClipState.NoAudio => "no recording",
		_ => "failed"
	};

	private static string StateClass(MinedClipState state) => state switch
	{
		MinedClipState.Ready => "bg-green-lt",
		MinedClipState.Queued or MinedClipState.Cutting => "bg-azure-lt",
		MinedClipState.NoAudio => "bg-secondary-lt",
		_ => "bg-red-lt"
	};

	/// <summary>
	/// Failures end up in <see cref="_error"/>; null means there is no response to work with.
	/// </summary>
	private async Task<MiningResponseTransmission?> SendAsync(MiningRequestTransmission transmission)
	{
		SocketClient? client = await SocketClientContainer.EnsureConnectedAsync();
		if (client is null || !SocketClientContainer.IsConnected)
		{
			return null;
		}
		try
		{
			MiningResponseTransmission response = await new MiningRequest(transmission).Get(client, MiningRequest.Timeout);
			_error = response.Error;
			return response;
		}
		catch (TimeoutException)
		{
			_error = "That took too long. Try again in a moment.";
			return null;
		}
	}

	private void OnConnectionStateChanged()
	{
		_ = InvokeAsync(async () =>
		{
			if (!_loaded && _offline && SocketClientContainer.IsConnected)
			{
				await LoadAsync();
			}
			StateHasChanged();
		});
	}

	public void Dispose()
	{
		SocketClientContainer.ConnectionStateChanged -= OnConnectionStateChanged;
	}
}
