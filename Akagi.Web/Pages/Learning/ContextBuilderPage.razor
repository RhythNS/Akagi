	private async Task AddAsync(ContextKind kind, string key, string title, bool save = true)
	{
		if (kind != ContextKind.Vocabulary && Has(kind, key))
		{
			return;
		}
		_blocks.Add(ContextBlock.Create(kind, key, title));
		if (save)
		{
			await SaveAsync();
			StateHasChanged();
			await FetchMissingAsync();
		}
	}

	private async Task AddAllCallsAsync()
	{
		// Oldest first, so the calls read in the order they happened
		foreach (CallAnalysisSummary call in _calls.Where(c => c.State == CallAnalysisState.Completed).OrderBy(c => c.Date))
		{
			await AddAsync(ContextKind.Call, call.Id, ContextWriter.CallTitle(call), save: false);
		}
		await SaveAsync();
		StateHasChanged();
		await FetchMissingAsync();
	}

	private async Task AddNoteAsync()
	{
		_blocks.Add(new ContextBlock { Kind = ContextKind.Note, Title = "Note" });
		await SaveAsync();
	}

	private async Task RemoveAsync(ContextBlock block)
	{
		_blocks.Remove(block);
		_open.Remove(block.Id);
		_picking.Remove(block.Id);
		_written.Remove(block.Id);
		await SaveAsync();
	}

	private async Task ClearAsync()
	{
		if (!_confirmClear)
		{
			_confirmClear = true;
			return;
		}
		_confirmClear = false;
		_blocks.Clear();
		_open.Clear();
		_written.Clear();
		await SaveAsync();
	}

	private async Task MoveAsync(int from, int to)
	{
		if (from == to || from < 0 || to < 0 || from >= _blocks.Count || to >= _blocks.Count)
		{
			return;
		}
		ContextBlock block = _blocks[from];
		_blocks.RemoveAt(from);
		_blocks.Insert(to, block);
		await SaveAsync();
	}

	private async Task DropAsync(int position)
	{
		int? from = _dragIndex;
		EndDrag();
		if (from is int index)
		{
			await MoveAsync(index, position);
		}
	}

	private void EndDrag()
	{
		_dragIndex = null;
		_dropIndex = null;
	}

	private async Task IncludeAsync(ContextBlock block, bool included)
	{
		block.Included = included;
		await SavedAndFetchAsync();
	}

	private async Task ToggleSectionAsync(ContextBlock block, string section)
	{
		if (!block.Sections.Remove(section))
		{
			block.Sections.Add(section);
		}
		await SavedAndFetchAsync();
	}

	private async Task LimitAsync(ContextBlock block, string? value)
	{
		block.Limit = int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out int limit) ? limit : block.Limit;
		await SaveAsync();
	}

	private async Task PartnerAsync(ContextBlock block, string? partner)
	{
		block.Partner = partner ?? string.Empty;
		block.Title = VocabularyTitle(block.Key, block.Partner);
		await SaveAsync();
		StateHasChanged();
		await FetchMissingAsync();
	}

	private async Task NoteAsync(ContextBlock block, string? title, string? text)
	{
		if (title != null)
		{
			block.Title = title;
		}
		if (text != null)
		{
			block.Text = text;
		}
		await SaveAsync();
	}

	private async Task RetryAsync(ContextBlock block)
	{
		_failed.Remove(block.DataKey);
		StateHasChanged();
		await FetchMissingAsync();
	}

	/// <summary>
	/// One pickable item: its checkbox, and for an example from a call how many transcript lines to quote around it.
	/// </summary>
	private RenderFragment ItemRow(ContextBlock block, ContextItem item, bool enabled, bool child)
	{
		bool on = enabled && block.IsPicked(item.Id, item.Default);
		int around = block.AroundOf(item.Id);
		bool own = block.AroundFor.ContainsKey(item.Id);
		return @<div class="d-flex align-items-start gap-2 py-1 @(child ? "ps-4" : "")" data-item="@item.Id">
			<input type="checkbox" class="form-check-input m-0 mt-1 flex-shrink-0" checked="@on" disabled="@(!enabled)" aria-label="Include in the file"
				   data-item-pick @onchange="e => PickAsync(block, item, e.Value is true)" />
			<div class="me-auto small text-break @(on ? "" : "text-secondary")" style="min-width: 0;">
				<span lang="ja" class="@(child ? "" : "fw-medium")">@item.Text</span>
				@if (!string.IsNullOrWhiteSpace(item.Detail))
				{
					<span class="text-secondary ms-1" lang="ja">@item.Detail</span>
				}
			</div>
			@if (item.CanQuote && on)
			{
				<div class="btn-group btn-group-sm flex-shrink-0" title="Transcript lines quoted before and after this example">
					<button type="button" class="btn btn-ghost-secondary px-2 py-0" aria-label="Fewer transcript lines" disabled="@(around == 0)"
							data-around-less @onclick="() => AroundAsync(block, item.Id, around - 1)">-</button>
					<span class="d-inline-flex align-items-center px-1 small @(own ? "fw-bold text-primary" : "text-secondary")" data-around="@around"
						  title="@(own ? "Set for this example" : "The block's setting")">&plusmn;@around</span>
					<button type="button" class="btn btn-ghost-secondary px-2 py-0" aria-label="More transcript lines" disabled="@(around >= ContextItems.MostAround)"
							data-around-more @onclick="() => AroundAsync(block, item.Id, around + 1)">+</button>
				</div>
			}
		</div>;
	}

	private void TogglePicking(ContextBlock block)
	{
		if (!_picking.Remove(block.Id))
		{
			_picking.Add(block.Id);
		}
	}

	private async Task PickAsync(ContextBlock block, ContextItem item, bool picked)
	{
		block.Pick(item.Id, picked, item.Default);
		await SavedAndFetchAsync();
	}

	private async Task PickAllAsync(ContextBlock block, ContextItemGroup group, bool picked)
	{
		foreach (ContextItem item in group.Items)
		{
			block.Pick(item.Id, picked, item.Default);
		}
		await SavedAndFetchAsync();
	}

	private async Task AroundAsync(ContextBlock block, string id, int lines)
	{
		block.SetAround(id, lines);
		await SavedAndFetchAsync();
	}

	private async Task BlockAroundAsync(ContextBlock block, string? value)
	{
		if (!int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out int lines))
		{
			return;
		}
		block.Around = Math.Clamp(lines, 0, ContextItems.MostAround);
		// Examples set to the new default by hand need no exception any more
		foreach (string id in block.AroundFor.Where(p => p.Value == block.Around).Select(p => p.Key).ToList())
		{
			block.AroundFor.Remove(id);
		}
		await SavedAndFetchAsync();
	}

	/// <summary>
	/// Saves the list and loads calls the change made necessary, such as one whose transcript is now quoted.
	/// </summary>
	private async Task SavedAndFetchAsync()
	{
		await SaveAsync();
		StateHasChanged();
		await FetchMissingAsync();
	}

	private void TogglePreview(ContextBlock block)
	{
		if (!_open.Remove(block.Id))
		{
			_open.Add(block.Id);
		}
	}

	private async Task SaveAsync()
	{
		if (!_restored || _module == null)
		{
			return;
		}
		try
		{
			await _module.InvokeVoidAsync("save", StorageKey, JsonSerializer.Serialize(_blocks));
		}
		catch (JSException)
		{
			// Keeping the list is a convenience
		}
		catch (JSDisconnectedException)
		{
			// The circuit is gone
		}
	}

	private async Task DownloadAsync()
	{
		string text = Exported;
		if (_module == null || text.Length == 0)
		{
			return;
		}
		try
		{
			await _module.InvokeVoidAsync("download", $"akagi-context-{DateTime.Now:yyyy-MM-dd}.txt", text);
		}
		catch (JSException)
		{
			// The download is a convenience
		}
	}

	private async Task CopyAsync()
	{
		string text = Exported;
		if (_module == null || text.Length == 0)
		{
			return;
		}
		try
		{
			_copied = await _module.InvokeAsync<bool>("copy", text);
		}
		catch (JSException)
		{
			_copied = false;
		}
		if (_copied)
		{
			StateHasChanged();
			try
			{
				await Task.Delay(TimeSpan.FromSeconds(2), _disposed.Token);
			}
			catch (TaskCanceledException)
			{
				return;
			}
			_copied = false;
		}
	}

	private void OnConnectionStateChanged()
	{
		_ = InvokeAsync(async () =>
		{
			if (_offline && SocketClientContainer.IsConnected)
			{
				await RefreshAsync();
			}
			StateHasChanged();
		});
	}

	public async ValueTask DisposeAsync()
	{
		SocketClientContainer.ConnectionStateChanged -= OnConnectionStateChanged;
		_disposed.Cancel();
		if (_module != null)
		{
			try
			{
				await _module.DisposeAsync();
			}
			catch (JSDisconnectedException)
			{
				// The circuit is gone
			}
		}
	}
}
