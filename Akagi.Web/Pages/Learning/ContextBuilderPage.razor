			return (null, "The Akagi backend cannot be reached.");
		}
		try
		{
			LearningResponseTransmission response = await new LearningRequest(new LearningRequestTransmission { Action = LearningAction.Overview })
				.Get(client, LearningRequest.OverviewTimeout);
			return (response, response.Error);
		}
		catch (TimeoutException)
		{
