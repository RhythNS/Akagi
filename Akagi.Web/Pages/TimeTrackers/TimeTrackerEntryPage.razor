@using Akagi.Web.Data
@using Akagi.Web.Icons
@using Akagi.Web.Models
@using Akagi.Web.Models.TimeTrackers
@using TabBlazor.Services

@inject IDefinitionDatabase DefinitionDatabase
@inject IEntryDatabase EntryDatabase
@inject ToastService ToastService
@inject NavigationManager Navigation

@page "/TimeTracking/{DefinitionId}/entry/{EntryId}"
@page "/TimeTracking/{DefinitionId}/entry/new"

<PageTitle>@(IsEditMode ? "Edit Entry" : "New Entry") - @(_definition?.Name ?? "Time Tracking")</PageTitle>

<div class="page-header d-print-none mb-4">
	<div class="row g-2 align-items-center">
		<div class="col">
			<div class="page-pretitle">@(_definition?.Name ?? "Time Tracking")</div>
			<h2 class="page-title">@(IsEditMode ? "Edit Time Entry" : "Log Time Entry")</h2>
		</div>
		<div class="col-auto ms-auto">
			<a href="@detailPath" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
				<Icon IconType="@Icons.ArrowLeft" Size="16" />
				<span>Back to Entries</span>
			</a>
		</div>
	</div>
</div>

<TabBlazor.Card>
	@if (_entry == null || _definition == null)
	{
		<CardHeader>
			<TabBlazor.CardTitle>
				Time Tracker Not Found
			</TabBlazor.CardTitle>
		</CardHeader>
	}
	else
	{
		<CardBody>
			<TablerForm Model="_entry"
						OnValidSubmit="Submit">

				@foreach (var item in _definition.Fields)
				{
					<div class="mb-3">
						<label class="form-label">
							@item.Name
						</label>
						<div class="d-flex flex-wrap align-items-center gap-2">
							@{
								switch (item.Type)
								{
									case FieldType.Boolean:
										bool boolThing = Convert.ToBoolean(_entry.Values[item.Name]);
										<label class="form-check form-switch m-0">
											<InputCheckbox class="form-check-input"
														   Value="Convert.ToBoolean(_entry.Values[item.Name])"
														   ValueChanged="@(x => _entry.Values[item.Name] = x)"
														   ValueExpression="() => boolThing" />
											<span class="form-check-label">@(boolThing ? "Yes" : "No")</span>
										</label>
										break;
									case FieldType.Int:
										int intThing = Convert.ToInt32(_entry.Values[item.Name]);
										<InputNumber class="form-control"
													 TValue="int"
													 Value="Convert.ToInt32(_entry.Values[item.Name])"
													 ValueChanged="@(x => _entry.Values[item.Name] = x)"
													 ValueExpression="() => intThing" />
										break;
									case FieldType.Float:
										float floatThing = Convert.ToSingle(_entry.Values[item.Name]);
										<InputNumber class="form-control"
													 TValue="float"
													 Value="Convert.ToSingle(_entry.Values[item.Name])"
													 ValueChanged="@(x => _entry.Values[item.Name] = x)"
													 ValueExpression="() => floatThing" />
										break;
									case FieldType.Text:
										string stringThing = Convert.ToString(_entry.Values[item.Name]) ?? "";
										var listId = $"list-{item.Name.Replace(" ", "-")}";
										<InputText class="form-control"
												   list="@listId"
												   Value=@(Convert.ToString(_entry.Values[item.Name]))
												   ValueChanged="x => _entry.Values[item.Name] = x"
												   ValueExpression="() => stringThing" />
										<datalist id="@listId">
											@if (_textFieldSuggestions.TryGetValue(item.Name, out var options))
											{
												foreach (var opt in options.Distinct(StringComparer.OrdinalIgnoreCase))
												{
													<option value="@opt"></option>
												}
											}
										</datalist>
										break;
									case FieldType.DateTime:
										DateTime dateTimeThing = Convert.ToDateTime(_entry.Values[item.Name]);
										<input type="datetime-local"
											   class="form-control"
											   style="max-width: 260px;"
											   value="@(dateTimeThing.ToString("yyyy-MM-ddTHH:mm"))"
											   @onchange="@(e => { if (DateTime.TryParse(e.Value?.ToString(), out var dt)) _entry.Values[item.Name] = dt; })" />
										break;
									case FieldType.Date:
										DateOnly dateOnlyThing = (DateOnly)_entry.Values[item.Name];
										<InputDate class="form-control"
												   style="max-width: 220px;"
												   TValue="DateOnly"
												   Value="dateOnlyThing"
												   ValueChanged="@(x => _entry.Values[item.Name] = x)"
												   ValueExpression="() => dateOnlyThing" />
										break;
									case FieldType.Time:
										TimeOnly timeOnlyThing = (TimeOnly)_entry.Values[item.Name];
										<input type="time"
											   class="form-control"
											   style="max-width: 160px;"
											   value="@(timeOnlyThing.ToString("HH:mm"))"
											   @onchange="@(e => { if (TimeOnly.TryParse(e.Value?.ToString(), out var tm)) _entry.Values[item.Name] = tm; })" />
										<div class="btn-group" role="group" aria-label="Time quick adjustments">
											<button type="button" class="btn btn-outline-primary btn-sm"
													@onclick="() => _entry.Values[item.Name] = TimeOnly.FromDateTime(DateTime.Now)">
												Now
											</button>
											<button type="button" class="btn btn-outline-secondary btn-sm"
													@onclick="() => _entry.Values[item.Name] = ((TimeOnly)_entry.Values[item.Name]).AddMinutes(-5)">
												-5m
											</button>
											<button type="button" class="btn btn-outline-secondary btn-sm"
													@onclick="() => _entry.Values[item.Name] = ((TimeOnly)_entry.Values[item.Name]).AddMinutes(-1)">
												-1m
											</button>
											<button type="button" class="btn btn-outline-secondary btn-sm"
													@onclick="() => _entry.Values[item.Name] = ((TimeOnly)_entry.Values[item.Name]).AddMinutes(1)">
												+1m
											</button>
											<button type="button" class="btn btn-outline-secondary btn-sm"
													@onclick="() => _entry.Values[item.Name] = ((TimeOnly)_entry.Values[item.Name]).AddMinutes(5)">
												+5m
											</button>
										</div>
										break;
								}
							}
						</div>
					</div>
				}

				<div class="my-3 pt-2 border-top">
					<label class="form-check form-switch">
						<InputCheckbox class="form-check-input"
									   @bind-Value=_submitMultiple />
						<span class="form-check-label">Keep form open to submit multiple entries</span>
					</label>
				</div>

				<div class="d-flex align-items-center gap-2">
					<button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
						<Icon IconType="@Icons.Check" Size="16" />
						<span>Save Entry</span>
					</button>
					<a href="@detailPath" class="btn btn-ghost-secondary">
						Cancel
					</a>
				</div>
			</TablerForm>
		</CardBody>
	}
</TabBlazor.Card>

@code {
	[CascadingParameter(Name = "CurrentUser")]
	public User? CurrentUser { get; set; }

	[Parameter]
	public string? DefinitionId { get; set; }

	[Parameter]
	public string? EntryId { get; set; }

	private readonly Dictionary<string, List<string>> _textFieldSuggestions = new(StringComparer.OrdinalIgnoreCase);

	private Entry? _entry = null;
	private Definition? _definition = null;
	private bool _submitMultiple = false;

	private bool IsEditMode => !string.IsNullOrEmpty(EntryId) && EntryId != "new";
	private string detailPath => $"/TimeTracking/{DefinitionId}/detail";

	protected override async Task OnInitializedAsync()
	{
		if (CurrentUser == null || string.IsNullOrEmpty(DefinitionId))
		{
			return;
		}

		_definition = await DefinitionDatabase.GetDocumentByIdAsync(DefinitionId);

		if (_definition == null)
		{
			return;
		}

		if (IsEditMode)
		{
			_entry = await EntryDatabase.GetDocumentByIdAsync(EntryId!);
		}
		else
		{
			_entry = new Entry
			{
				DefinitionId = DefinitionId
			};

			foreach (FieldDefinition field in _definition.Fields)
			{
				switch (field.Type)
				{
					case FieldType.Boolean:
						_entry.Values.Add(field.Name, false);
						break;
					case FieldType.Int:
						_entry.Values.Add(field.Name, 0);
						break;
					case FieldType.Float:
						_entry.Values.Add(field.Name, 0.0f);
						break;
					case FieldType.Text:
						_entry.Values.Add(field.Name, string.Empty);
						break;
					case FieldType.DateTime:
						_entry.Values.Add(field.Name, DateTime.Today);
						break;
					case FieldType.Date:
						_entry.Values.Add(field.Name, DateOnly.FromDateTime(DateTime.Today));
						break;
					case FieldType.Time:
						_entry.Values.Add(field.Name, TimeOnly.FromDateTime(DateTime.Now));
						break;
					default:
						throw new ArgumentOutOfRangeException();
				}
			}
		}

		await LoadSuggestions();
	}

	private async Task LoadSuggestions()
	{
		foreach (var field in _definition?.Fields.Where(f => f.Type == FieldType.Text) ?? [])
		{
			object[] values = await EntryDatabase.GetDistinctValuesAsync(field.Name);
			List<string> suggestions = values.Select(v => v?.ToString() ?? string.Empty).ToList();
			_textFieldSuggestions[field.Name] = suggestions;
		}
	}

	private async Task Submit(EditContext context)
	{
		if (_entry == null || context.Validate() == false || CurrentUser == null)
		{
			await ToastService.AddToastAsync(new ToastModel
			{
				Title = "Error",
				Message = "Could not save entry..."
			});
			return;
		}

		_entry.CreatedAt = DateTime.UtcNow;
		_entry.DefinitionId = DefinitionId!;

		await EntryDatabase.SaveDocumentAsync(_entry);
		await ToastService.AddToastAsync(new ToastModel
		{
			Title = "Success",
			Message = "Entry saved successfully!"
		});

		if (_submitMultiple)
		{
			_entry.Id = null;
			return;
		}
		Navigation.NavigateTo($"/TimeTracking/{DefinitionId}/detail");
	}
}
