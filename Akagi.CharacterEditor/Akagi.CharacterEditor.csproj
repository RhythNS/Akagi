<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exe (console subsystem) so headless CLI runs block the shell and return exit codes. App hides its own console in GUI mode. -->
    <OutputType>Exe</OutputType>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nodify" Version="7.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Akagi.Bridge\Akagi.Bridge.csproj" />
    <ProjectReference Include="..\Akagi\Akagi.csproj" />
  </ItemGroup>

</Project>
